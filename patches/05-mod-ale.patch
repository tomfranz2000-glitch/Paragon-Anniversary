+    /**
+     * Returns the creature's authoritative kill-XP reward for a hypothetical
+     * player at the creature's level. Mirrors Acore::XP::Gain and
+     * KillRewarder's low-health adjustment while deliberately excluding
+     * player-specific group, aura, rested and level-difference modifiers.
+     *
+     * @return uint32 atLevelXPReward
+     */
+    int GetAtLevelXPReward(lua_State* L, Creature* creature)
+    {
+        uint32 gain = 0;
+
+        if (!creature->IsTotem() && !creature->IsPet() && !creature->IsCritter() &&
+            !creature->HasFlagsExtra(CREATURE_FLAG_EXTRA_NO_XP))
+        {
+            uint8 const level = creature->GetLevel();
+            gain = Acore::XP::BaseGain(
+                level,
+                level,
+                GetContentLevelsForMapAndZone(creature->GetMapId(), creature->GetZoneId()));
+
+            if (gain)
+            {
+                CreatureTemplate const* creatureTemplate = creature->GetCreatureTemplate();
+                float modifier = creature->isElite() ? 2.0f : 1.0f;
+                modifier *= creatureTemplate->ModExperience;
+                modifier *= sWorld->getRate(RATE_XP_KILL);
+
+                if (creature->GetPlayerDamageReq() && creature->GetMaxHealth())
+                    modifier *= 1.0f - 2.0f * creature->GetPlayerDamageReq() / creature->GetMaxHealth();
+
+                gain = uint32(gain * modifier);
+
+                if (creatureTemplate->ModHealth <= 0.75f && creatureTemplate->ModHealth >= 0.0f)
+                    gain = uint32(gain * creatureTemplate->ModHealth);
+            }
+        }
+
+        ALE::Push(L, gain);
+        return 1;
+    }
+
