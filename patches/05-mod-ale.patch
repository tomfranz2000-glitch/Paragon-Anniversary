+bool ALE::OnCanLearnTalent(Player* player, uint32 talentId, uint32 rank)
+{
+    START_HOOK_WITH_RETVAL(PLAYER_EVENT_ON_CAN_LEARN_TALENT, true);
+    Push(player);
+    Push(talentId);
+    Push(rank);
+    // default_value true: handlers only need to return false to refuse the
+    // learn; returning nothing (or true) allows it.
+    return CallAllFunctionsBool(PlayerEventBindings, key, true);
+}
