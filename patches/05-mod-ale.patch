+// Paragon §1p: surfaces the core's authoritative dungeon-completion signal
+// to Lua (MAP_EVENT_ON_ENCOUNTER_COMPLETE). Unlike creature-death watching
+// this catches both credit types without replacing any boss AI, and
+// dungeonCompleted is non-zero exactly when the final encounter of
+// (map, difficulty) was just credited.
+class ALE_GlobalScript : public GlobalScript
+{
+public:
+    ALE_GlobalScript() : GlobalScript("ALE_GlobalScript", {
+        GLOBALHOOK_ON_AFTER_UPDATE_ENCOUNTER_STATE
+    }) { }
+
+    void OnAfterUpdateEncounterState(Map* map, EncounterCreditType type, uint32 creditEntry, Unit* source, Difficulty /*difficulty_fixed*/, DungeonEncounterList const* /*encounters*/, uint32 dungeonCompleted, bool /*updated*/) override
+    {
+        sALE->OnEncounterComplete(map, uint32(type), creditEntry, source, dungeonCompleted);
+    }
+};
