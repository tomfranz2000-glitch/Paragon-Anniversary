+    void OnPlayerRewardKillRewarder(Player* player, KillRewarder* rewarder, bool isDungeon, float& /*rate*/) override
+    {
+        if (rewarder)
+            if (Unit* victim = rewarder->GetVictim())
+                if (Creature* creature = victim->ToCreature())
+                {
+                    uint32 participantCount = 1;
+                    bool isRaid = false;
+                    Player* killer = rewarder->GetKiller();
+                    if (killer && killer->GetVehicle())
+                        return;
+
+                    Group* group = killer ? killer->GetGroup() : nullptr;
+                    if (group)
+                    {
+                        participantCount = 0;
+                        for (GroupReference* itr = group->GetFirstMember(); itr; itr = itr->next())
+                            if (Player* member = itr->GetSource())
+                                if (member->IsAlive() &&
+                                    (member == killer || member->IsAtGroupRewardDistance(creature)))
+                                    ++participantCount;
+
+                        isRaid = creature->GetMap()->IsRaid() && group->isRaidGroup();
+                    }
+
+                    sALE->OnKillReward(player, creature, isDungeon, participantCount, isRaid);
+                }
+    }
