+// Paragon §1p: fired from GlobalScript::OnAfterUpdateEncounterState — the
+// core's own completion matcher (Map::UpdateEncounterState). source is the
+// credited creature/caster and can be nullptr (script-driven credits).
+void ALE::OnEncounterComplete(Map* map, uint32 creditType, uint32 creditEntry, Unit* source, uint32 dungeonId)
+{
+    START_HOOK(MAP_EVENT_ON_ENCOUNTER_COMPLETE);
+    Push(map);
+    Push(creditType);
+    Push(creditEntry);
+    if (source)
+        Push(source);
+    else
+        Push();
+    Push(dungeonId);
+    CallAllFunctions(ServerEventBindings, key);
+}
