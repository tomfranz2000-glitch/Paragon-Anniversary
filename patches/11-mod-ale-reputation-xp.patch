+    /**
+     * Returns the race/class-specific absolute base standing for a faction.
+     *
+     * @param uint32 factionId
+     * @param uint8 raceId
+     * @param uint8 classId
+     * @return int32 baseStanding, or nil when the faction is invalid
+     */
+    int GetFactionBaseReputation(lua_State* L)
+    {
+        uint32 const factionId = ALE::CHECKVAL<uint32>(L, 1);
+        uint8 const raceId = ALE::CHECKVAL<uint8>(L, 2);
+        uint8 const classId = ALE::CHECKVAL<uint8>(L, 3);
+        FactionEntry const* faction = sFactionStore.LookupEntry(factionId);
+        if (!faction || !faction->CanHaveReputation())
+        {
+            ALE::Push(L);
+            return 1;
+        }
+
+        ALE::Push(L, sObjectMgr->GetBaseReputationOf(faction, raceId, classId));
+        return 1;
+    }
