+void ScriptMgr::OnPlayerProfessionAction(Player* player, uint32 actionKind, uint32 skillId, uint32 contextId,
+    uint32 quantity)
+{
+    static std::atomic<uint32> nextActionToken { 0 };
+
+    uint32 actionToken = 0;
+    while (!actionToken)
+        actionToken = nextActionToken.fetch_add(1, std::memory_order_relaxed) + 1;
+
+    CALL_ENABLED_HOOKS(PlayerScript, PLAYERHOOK_ON_PROFESSION_ACTION,
+        script->OnPlayerProfessionAction(player, actionKind, skillId, contextId, quantity, actionToken));
+}
