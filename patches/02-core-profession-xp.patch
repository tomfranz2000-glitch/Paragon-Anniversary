+void Spell::RecordProfessionAction(uint32 actionKind, uint32 skillId, uint32 contextId, uint32 quantity,
+    bool accumulateQuantity)
+{
+    if (!actionKind || !skillId || !contextId || !quantity)
+        return;
+
+    if (!m_professionActionKind)
+    {
+        m_professionActionKind = actionKind;
+        m_professionActionSkillId = skillId;
+        m_professionActionContextId = contextId;
+        m_professionActionQuantity = quantity;
+        return;
+    }
+
+    if (!accumulateQuantity || m_professionActionKind != actionKind ||
+        m_professionActionSkillId != skillId || m_professionActionContextId != contextId)
+        return;
+
+    if (quantity > UINT32_MAX - m_professionActionQuantity)
+        m_professionActionQuantity = UINT32_MAX;
+    else
+        m_professionActionQuantity += quantity;
+}
+
+void Spell::SendProfessionAction()
+{
+    Player* player = m_caster->ToPlayer();
+    if (!player || !m_professionActionKind)
+        return;
+
+    uint32 actionKind = m_professionActionKind;
+    uint32 skillId = m_professionActionSkillId;
+    uint32 contextId = m_professionActionContextId;
+    uint32 quantity = m_professionActionQuantity;
+
+    m_professionActionKind = 0;
+    m_professionActionSkillId = 0;
+    m_professionActionContextId = 0;
+    m_professionActionQuantity = 0;
+
+    sScriptMgr->OnPlayerProfessionAction(player, actionKind, skillId, contextId, quantity);
+}
