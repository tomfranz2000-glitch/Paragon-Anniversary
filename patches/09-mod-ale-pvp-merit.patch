+void PvPMeritTracker::OnBattlegroundEndReward(Battleground* bg, Player* player, TeamId winnerTeam)
+{
+    if (!bg || !player)
+        return;
+
+    BattlegroundState& state = _impl->Battlegrounds[bg->GetInstanceID()];
+    if (!state.Started)
+    {
+        state.InstanceId = bg->GetInstanceID();
+        state.Started = true;
+        state.StartedAt = Clock::now();
+        state.StartedEpochMilliseconds = GetEpochMilliseconds();
+    }
+
+    ParticipantState& participant = RegisterParticipant(state.Participants, player, player->GetBgTeamId());
+    if (participant.Settled)
+        return;
+
+    uint32 const elapsed = GetElapsedSeconds(state.StartedAt);
+    OpenPresence(participant, elapsed);
+    ClosePresence(participant, elapsed);
+
+    PvPMatchSettlement settlement;
+    settlement.MatchKind = bg->isArena() ? PVP_MATCH_KIND_ARENA : PVP_MATCH_KIND_BATTLEGROUND;
+    settlement.Result = winnerTeam == TEAM_NEUTRAL ? PVP_RESULT_DRAW :
+        (player->GetBgTeamId() == winnerTeam ? PVP_RESULT_WIN : PVP_RESULT_LOSS);
+    settlement.DurationSeconds = elapsed;
+    settlement.ActiveSeconds = participant.PresenceSeconds;
+    settlement.PresenceBuckets = uint32(participant.PresenceBuckets.size());
+    settlement.ActiveBuckets = uint32(participant.ActiveBuckets.size());
+    settlement.TacticalActions = participant.TacticalActions;
+    settlement.BattlegroundTypeId = uint8(bg->GetBgTypeID(true));
+    settlement.MapId = bg->GetMapId();
+    settlement.InstanceId = bg->GetInstanceID();
+    settlement.ArenaType = bg->GetArenaType();
+    settlement.Rated = bg->isRated();
+    settlement.BracketId = bg->GetUniqueBracketId();
+    settlement.PlayerTeam = uint8(player->GetBgTeamId());
+    settlement.WinnerTeam = uint8(winnerTeam);
+    settlement.PvPDamageDone = participant.PvPDamageDone;
+    settlement.PvPHealingDone = participant.PvPHealingDone;
+    settlement.IsBot = participant.Bot;
+    settlement.AccountId = participant.AccountId;
+    settlement.Inactive = player->HasAura(SPELL_AURA_PLAYER_INACTIVE);
+    settlement.Deserter = participant.Deserter;
+
+    auto const scoreItr = bg->GetPlayerScores()->find(player->GetGUID().GetCounter());
+    if (scoreItr != bg->GetPlayerScores()->end() && scoreItr->second)
+    {
+        BattlegroundScore const* score = scoreItr->second;
+        settlement.KillingBlows = score->GetKillingBlows();
+        settlement.Deaths = score->GetDeaths();
+        settlement.HonorableKills = score->GetHonorableKills();
+        settlement.BonusHonor = score->GetBonusHonor();
+        settlement.DamageDone = score->GetDamageDone();
+        settlement.HealingDone = score->GetHealingDone();
+        settlement.Objective1 = score->GetAttr1();
+        settlement.Objective2 = score->GetAttr2();
+        settlement.Objective3 = score->GetAttr3();
+        settlement.Objective4 = score->GetAttr4();
+        settlement.Objective5 = score->GetAttr5();
+    }
+
+    OpponentSummary const opponents = BuildOpponentSummary(state.Participants, participant);
+    settlement.OpponentCount = opponents.OpponentCount;
+    settlement.RealOpponentCount = opponents.RealOpponentCount;
+    settlement.BotOpponentCount = opponents.BotOpponentCount;
+    settlement.UniqueOpponentAccounts = opponents.UniqueOpponentAccounts;
+    settlement.SameAccountOpponent = opponents.SameAccountOpponent;
+    settlement.SameIpOpponent = opponents.SameIpOpponent;
+    settlement.OpponentRosterKey = opponents.RosterKey;
+    settlement.EventToken = Acore::StringFormat("match:{}:{}:{}", state.InstanceId,
+        state.StartedEpochMilliseconds, participant.Guid);
+
+    participant.Settled = true;
+    sALE->OnPvPMatchComplete(player, settlement);
+}
