+void PvPMeritTracker::OnBattlefieldWarEnd(Battlefield* battlefield, bool endedByTimer)
+{
+    if (!battlefield)
+        return;
+
+    auto stateItr = _impl->Battlefields.find(battlefield->GetBattleId());
+    if (stateItr == _impl->Battlefields.end())
+        return;
+
+    BattlefieldState& state = stateItr->second;
+    uint32 const elapsed = GetElapsedSeconds(state.StartedAt);
+    TeamId const winnerTeam = battlefield->GetDefenderTeam();
+
+    std::vector<ObjectGuid> finishers;
+    for (uint8 team = 0; team < PVP_TEAMS_COUNT; ++team)
+        for (ObjectGuid const& playerGuid : battlefield->GetPlayersInWarSet(TeamId(team)))
+            if (Player* player = ObjectAccessor::FindPlayer(playerGuid))
+            {
+                ParticipantState& participant = RegisterParticipant(state.Participants, player, player->GetTeamId());
+                OpenPresence(participant, elapsed);
+                finishers.push_back(playerGuid);
+            }
+
+    for (ObjectGuid const& playerGuid : finishers)
+        if (Player* player = ObjectAccessor::FindPlayer(playerGuid))
+        {
+            ParticipantState& participant = RegisterParticipant(state.Participants, player, player->GetTeamId());
+            if (participant.Settled)
+                continue;
+
+            OpenPresence(participant, elapsed);
+            ClosePresence(participant, elapsed);
+
+            PvPBattlefieldSettlement settlement;
+            settlement.BattlefieldTypeId = battlefield->GetTypeId();
+            settlement.BattleId = battlefield->GetBattleId();
+            settlement.ZoneId = battlefield->GetZoneId();
+            settlement.MapId = battlefield->GetMapId();
+            settlement.Result = player->GetTeamId() == winnerTeam ? PVP_RESULT_WIN : PVP_RESULT_LOSS;
+            settlement.DurationSeconds = elapsed;
+            settlement.ActiveSeconds = participant.PresenceSeconds;
+            settlement.PresenceBuckets = uint32(participant.PresenceBuckets.size());
+            settlement.ActiveBuckets = uint32(participant.ActiveBuckets.size());
+            settlement.TacticalActions = participant.TacticalActions;
+            settlement.PlayerTeam = uint8(player->GetTeamId());
+            settlement.WinnerTeam = uint8(winnerTeam);
+            settlement.AttackerTeam = state.AttackerTeamAtStart;
+            settlement.DefenderTeamAtStart = state.DefenderTeamAtStart;
+            settlement.EndedByTimer = endedByTimer;
+            settlement.IsBot = participant.Bot;
+            settlement.AccountId = participant.AccountId;
+            settlement.PlayerKills = participant.PlayerKills;
+            settlement.PvPDamageDone = participant.PvPDamageDone;
+            settlement.PvPHealingDone = participant.PvPHealingDone;
+            settlement.ObjectiveMajor = participant.ObjectiveMajor;
+            settlement.ObjectiveStandard = participant.ObjectiveStandard;
+            settlement.ObjectiveAssist = participant.ObjectiveAssist;
+            settlement.Inactive = player->HasAura(SPELL_AURA_PLAYER_INACTIVE);
+            settlement.Deserter = participant.Deserter;
+
+            OpponentSummary const opponents = BuildOpponentSummary(state.Participants, participant);
+            settlement.RealOpponentCount = opponents.RealOpponentCount;
+            settlement.BotOpponentCount = opponents.BotOpponentCount;
+            settlement.UniqueOpponentAccounts = opponents.UniqueOpponentAccounts;
+            settlement.SameAccountOpponent = opponents.SameAccountOpponent;
+            settlement.SameIpOpponent = opponents.SameIpOpponent;
+            settlement.OpponentRosterKey = opponents.RosterKey;
+            settlement.EventToken = Acore::StringFormat("battlefield:{}:{}:{}", state.BattleId,
+                state.StartedEpochMilliseconds, participant.Guid);
+
+            participant.Settled = true;
+            sALE->OnPvPBattlefieldComplete(player, settlement);
+        }
+
+    _impl->Battlefields.erase(stateItr);
+}
