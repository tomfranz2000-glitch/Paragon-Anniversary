+
+    ParticipantState& participant = RegisterParticipant(stateItr->second.Participants, player, player->GetTeamId());
+    participant.ObjectiveMajor = SaturatingAdd(participant.ObjectiveMajor, 1);
+    participant.TacticalActions = SaturatingAdd(participant.TacticalActions, 1);
+    MarkActive(participant, GetElapsedSeconds(stateItr->second.StartedAt));
+}
+
+void PvPMeritTracker::OnDuelStart(Player* player1, Player* player2)
+{
+    if (!player1 || !player2)
+        return;
+
+    DuelTrackingState& state = _impl->Duels[BuildDuelKey(player1, player2)];
+    state.StartedAt = Clock::now();
+    state.StartedEpochMilliseconds = GetEpochMilliseconds();
+}
+
+void PvPMeritTracker::OnDuelEnd(Player* winner, Player* loser, DuelCompleteType type)
+{
+    if (!winner || !loser)
+        return;
+
+    std::string const duelKey = BuildDuelKey(winner, loser);
+    auto stateItr = _impl->Duels.find(duelKey);
+    if (stateItr == _impl->Duels.end())
+        return;
+
+    DuelTrackingState const state = stateItr->second;
+    _impl->Duels.erase(stateItr);
+
+    WorldSession* winnerSession = winner->GetSession();
+    WorldSession* loserSession = loser->GetSession();
+    bool const sameAccount = winnerSession && loserSession && winnerSession->GetAccountId() == loserSession->GetAccountId();
+    bool const sameIp = winnerSession && loserSession &&
+        winnerSession->GetRemoteAddress() == loserSession->GetRemoteAddress();
+    bool const winnerBot = winnerSession && winnerSession->IsBot();
+    bool const loserBot = loserSession && loserSession->IsBot();
+    uint64 const firstGuid = std::min(GetGuidKey(winner), GetGuidKey(loser));
+    uint64 const secondGuid = std::max(GetGuidKey(winner), GetGuidKey(loser));
+    std::string const eventToken = Acore::StringFormat("duel:{}:{}:{}:{}:{}", firstGuid, secondGuid,
+        state.StartedEpochMilliseconds, GetGuidKey(winner), uint8(type));
+
+    sALE->OnPvPDuelComplete(winner, loser, type, GetElapsedSeconds(state.StartedAt), sameAccount, sameIp,
+        winnerBot, loserBot, eventToken);
+}
