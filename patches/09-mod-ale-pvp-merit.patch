+void PvPMeritTracker::OnPvPDamage(Unit* attacker, Unit* receiver, uint32 damage)
+{
+    Player* actor = GetControllingPlayer(attacker);
+    Player* target = GetControllingPlayer(receiver);
+    if (!actor || !target || actor == target || !damage)
+        return;
+
+    uint32 const effectiveDamage = std::min(damage, receiver->GetHealth());
+    if (!effectiveDamage)
+        return;
+
+    Battleground* actorBg = actor->GetBattleground();
+    Battleground* targetBg = target->GetBattleground();
+    if (actorBg && targetBg && actorBg->GetInstanceID() == targetBg->GetInstanceID() &&
+        actor->GetBgTeamId() != target->GetBgTeamId())
+    {
+        auto stateItr = _impl->Battlegrounds.find(actorBg->GetInstanceID());
+        if (stateItr != _impl->Battlegrounds.end() && stateItr->second.Started)
+        {
+            ParticipantState& participant = RegisterParticipant(stateItr->second.Participants, actor, actor->GetBgTeamId());
+            uint32 const elapsed = GetElapsedSeconds(stateItr->second.StartedAt);
+            participant.PvPDamageDone = SaturatingAdd(participant.PvPDamageDone, effectiveDamage);
+            MarkActive(participant, elapsed);
+        }
+        return;
+    }
+
+    Battlefield* battlefield = sBattlefieldMgr->GetBattlefieldToZoneId(actor->GetZoneId());
+    if (!battlefield || battlefield != sBattlefieldMgr->GetBattlefieldToZoneId(target->GetZoneId()) ||
+        actor->GetTeamId() == target->GetTeamId() ||
+        !battlefield->IsWarTime() || !battlefield->IsPlayerInBattlefield(actor->GetGUID()) ||
+        !battlefield->IsPlayerInBattlefield(target->GetGUID()))
+        return;
+
+    auto stateItr = _impl->Battlefields.find(battlefield->GetBattleId());
+    if (stateItr == _impl->Battlefields.end())
+        return;
+
+    ParticipantState& participant = RegisterParticipant(stateItr->second.Participants, actor, actor->GetTeamId());
+    uint32 const elapsed = GetElapsedSeconds(stateItr->second.StartedAt);
+    participant.PvPDamageDone = SaturatingAdd(participant.PvPDamageDone, effectiveDamage);
+    MarkActive(participant, elapsed);
+}
