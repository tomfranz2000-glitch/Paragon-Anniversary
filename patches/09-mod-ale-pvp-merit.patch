+
+namespace
+{
+constexpr uint8 PVP_MATCH_KIND_BATTLEGROUND = 1;
+constexpr uint8 PVP_MATCH_KIND_ARENA = 2;
+constexpr uint8 PVP_RESULT_LOSS = 0;
+constexpr uint8 PVP_RESULT_WIN = 1;
+constexpr uint8 PVP_RESULT_DRAW = 2;
+constexpr uint8 PVP_OBJECTIVE_TIER_STANDARD = 1;
+
+using Clock = std::chrono::steady_clock;
+
+uint64 GetGuidKey(Player const* player)
+{
+    return player->GetGUID().GetRawValue();
+}
+
+uint64 GetEpochMilliseconds()
+{
+    return uint64(std::chrono::duration_cast<std::chrono::milliseconds>(
+        GameTime::GetSystemTime().time_since_epoch()).count());
+}
+
+uint32 GetElapsedSeconds(Clock::time_point start)
+{
+    auto const elapsed = std::chrono::duration_cast<std::chrono::seconds>(Clock::now() - start).count();
+    return uint32(std::clamp<int64>(elapsed, 0, std::numeric_limits<uint32>::max()));
+}
+
+uint32 SaturatingAdd(uint32 current, uint32 value)
+{
+    if (value > std::numeric_limits<uint32>::max() - current)
+        return std::numeric_limits<uint32>::max();
+
+    return current + value;
+}
+
+struct ParticipantState
+{
+    uint64 Guid = 0;
+    uint32 AccountId = 0;
+    uint8 Team = uint8(TEAM_NEUTRAL);
+    bool Bot = false;
+    std::string RemoteAddress;
+    bool Present = false;
+    uint32 JoinedAtSecond = 0;
+    uint32 PresenceSeconds = 0;
+    std::unordered_set<uint32> PresenceBuckets;
+    std::unordered_set<uint32> ActiveBuckets;
+    uint32 TacticalActions = 0;
+    uint32 PvPDamageDone = 0;
+    uint32 PvPHealingDone = 0;
+    uint32 PlayerKills = 0;
+    uint32 ObjectiveMajor = 0;
+    uint32 ObjectiveStandard = 0;
+    uint32 ObjectiveAssist = 0;
+    bool Deserter = false;
+    bool Settled = false;
+};
+
+struct BattlegroundState
+{
+    uint32 InstanceId = 0;
+    bool Started = false;
+    Clock::time_point StartedAt;
+    uint64 StartedEpochMilliseconds = 0;
+    std::unordered_map<uint64, ParticipantState> Participants;
+};
+
+struct BattlefieldState
+{
+    uint32 BattleId = 0;
+    Clock::time_point StartedAt;
+    uint64 StartedEpochMilliseconds = 0;
+    uint8 DefenderTeamAtStart = uint8(TEAM_NEUTRAL);
+    uint8 AttackerTeamAtStart = uint8(TEAM_NEUTRAL);
+    std::unordered_map<uint64, ParticipantState> Participants;
+};
+
+struct DuelTrackingState
+{
+    Clock::time_point StartedAt;
+    uint64 StartedEpochMilliseconds = 0;
+};
+
+ParticipantState& RegisterParticipant(std::unordered_map<uint64, ParticipantState>& participants, Player* player, TeamId team)
+{
+    ParticipantState& participant = participants[GetGuidKey(player)];
+    participant.Guid = GetGuidKey(player);
+    participant.Team = uint8(team);
+
+    if (WorldSession* session = player->GetSession())
+    {
+        participant.AccountId = session->GetAccountId();
+        participant.Bot = session->IsBot();
+        participant.RemoteAddress = session->GetRemoteAddress();
+    }
+
+    return participant;
+}
+
+void OpenPresence(ParticipantState& participant, uint32 elapsedSeconds)
+{
+    if (participant.Present)
+        return;
+
+    participant.Present = true;
+    participant.JoinedAtSecond = elapsedSeconds;
+}
+
+void ClosePresence(ParticipantState& participant, uint32 elapsedSeconds)
+{
+    if (!participant.Present)
+        return;
+
+    uint32 const endSecond = std::max(elapsedSeconds, participant.JoinedAtSecond);
+    participant.PresenceSeconds = SaturatingAdd(participant.PresenceSeconds, endSecond - participant.JoinedAtSecond);
+
+    uint32 const firstBucket = participant.JoinedAtSecond / 60;
+    uint32 const finalBucket = endSecond == participant.JoinedAtSecond ? firstBucket : (endSecond - 1) / 60;
+    for (uint32 bucket = firstBucket; bucket <= finalBucket; ++bucket)
+    {
+        participant.PresenceBuckets.insert(bucket);
+        if (bucket == std::numeric_limits<uint32>::max())
+            break;
+    }
+
+    participant.Present = false;
+}
+
+void MarkActive(ParticipantState& participant, uint32 elapsedSeconds)
+{
+    participant.ActiveBuckets.insert(elapsedSeconds / 60);
+}
+
+bool IsObjectiveScore(uint32 type)
+{
+    switch (type)
+    {
+        case SCORE_FLAG_CAPTURES:
+        case SCORE_FLAG_RETURNS:
+        case SCORE_BASES_ASSAULTED:
+        case SCORE_BASES_DEFENDED:
+        case SCORE_GRAVEYARDS_ASSAULTED:
+        case SCORE_GRAVEYARDS_DEFENDED:
+        case SCORE_TOWERS_ASSAULTED:
+        case SCORE_TOWERS_DEFENDED:
+        case SCORE_MINES_CAPTURED:
+        case SCORE_DESTROYED_DEMOLISHER:
+        case SCORE_DESTROYED_WALL:
+            return true;
+        default:
+            return false;
+    }
+}
+
+std::string BuildOpponentRosterKey(std::set<uint32> const& accountIds)
+{
+    uint64 hash = 14695981039346656037ULL;
+    bool first = true;
+    for (uint32 accountId : accountIds)
+    {
+        if (!first)
+        {
+            hash ^= uint8(':');
+            hash *= 1099511628211ULL;
+        }
+
+        std::string const account = std::to_string(accountId);
+        for (unsigned char character : account)
+        {
+            hash ^= character;
+            hash *= 1099511628211ULL;
+        }
+        first = false;
+    }
+
+    std::ostringstream result;
+    result << "accounts_" << std::hex << std::nouppercase << std::setw(16) << std::setfill('0') << hash
+           << '_' << std::dec << accountIds.size();
+    return result.str();
+}
+
+struct OpponentSummary
+{
+    uint32 OpponentCount = 0;
+    uint32 RealOpponentCount = 0;
+    uint32 BotOpponentCount = 0;
+    uint32 UniqueOpponentAccounts = 0;
+    bool SameAccountOpponent = false;
+    bool SameIpOpponent = false;
+    std::string RosterKey;
+};
+
+OpponentSummary BuildOpponentSummary(std::unordered_map<uint64, ParticipantState> const& participants,
+    ParticipantState const& recipient)
+{
+    OpponentSummary summary;
+    std::set<uint32> accountIds;
+
+    for (auto const& [guid, participant] : participants)
+    {
+        if (guid == recipient.Guid || participant.Team == recipient.Team ||
+            (!participant.Present && !participant.PresenceSeconds))
+            continue;
+
+        ++summary.OpponentCount;
+        if (participant.Bot)
+            ++summary.BotOpponentCount;
+        else
+            ++summary.RealOpponentCount;
+
+        if (participant.AccountId)
+            accountIds.insert(participant.AccountId);
+        if (participant.AccountId && participant.AccountId == recipient.AccountId)
+            summary.SameAccountOpponent = true;
+        if (!recipient.RemoteAddress.empty() && participant.RemoteAddress == recipient.RemoteAddress)
+            summary.SameIpOpponent = true;
+    }
+
+    summary.UniqueOpponentAccounts = uint32(accountIds.size());
+    summary.RosterKey = BuildOpponentRosterKey(accountIds);
+    return summary;
+}
+
+std::string BuildDuelKey(Player const* player1, Player const* player2)
+{
+    uint64 const first = std::min(GetGuidKey(player1), GetGuidKey(player2));
+    uint64 const second = std::max(GetGuidKey(player1), GetGuidKey(player2));
+    return Acore::StringFormat("{}:{}", first, second);
+}
+
+Player* GetControllingPlayer(Unit* unit)
+{
+    return unit ? unit->GetCharmerOrOwnerPlayerOrPlayerItself() : nullptr;
+}
