+#define START_PVP_HOOK(EVENT) \
+    if (!ALEConfig::GetInstance().IsALEEnabled())\
+        return;\
+    auto key = EventKey<PlayerEvents>(EVENT);\
+    if (!PlayerEventBindings->HasBindingsFor(key))\
+        return;\
+    LOCK_ALE
+
+void ALE::OnPvPHonor(Player* player, Player* victim, uint32 finalHonor, uint8 honorSource, uint8 battlegroundTypeId,
+    uint8 arenaType, bool rated, bool generatedBattlegroundXP, std::string const& eventToken)
+{
+    sPvPMeritTracker.OnPvPHonor(player, finalHonor, honorSource);
+
+    START_PVP_HOOK(PLAYER_EVENT_ON_PVP_HONOR);
+    Push(player);
+    Push(victim);
+    Push(finalHonor);
+    Push(honorSource);
+    Push(battlegroundTypeId);
+    Push(arenaType);
+    Push(rated);
+    Push(generatedBattlegroundXP);
+    Push(eventToken);
+    CallAllFunctions(PlayerEventBindings, key);
+}
+
+void ALE::OnPvPMatchComplete(Player* player, PvPMatchSettlement const& settlement)
+{
+    START_PVP_HOOK(PLAYER_EVENT_ON_PVP_MATCH_COMPLETE);
+    Push(player);
+    Push(settlement.MatchKind);
+    Push(settlement.Result);
+    Push(settlement.DurationSeconds);
+    Push(settlement.ActiveSeconds);
+    Push(settlement.PresenceBuckets);
+    Push(settlement.ActiveBuckets);
+    Push(settlement.TacticalActions);
+    Push(settlement.BattlegroundTypeId);
+    Push(settlement.MapId);
+    Push(settlement.InstanceId);
+    Push(settlement.ArenaType);
+    Push(settlement.Rated);
+    Push(settlement.BracketId);
+    Push(settlement.PlayerTeam);
+    Push(settlement.WinnerTeam);
+    Push(settlement.KillingBlows);
+    Push(settlement.Deaths);
+    Push(settlement.HonorableKills);
+    Push(settlement.BonusHonor);
+    Push(settlement.DamageDone);
+    Push(settlement.HealingDone);
+    Push(settlement.PvPDamageDone);
+    Push(settlement.PvPHealingDone);
+    Push(settlement.Objective1);
+    Push(settlement.Objective2);
+    Push(settlement.Objective3);
+    Push(settlement.Objective4);
+    Push(settlement.Objective5);
+    Push(settlement.IsBot);
+    Push(settlement.AccountId);
+    Push(settlement.OpponentCount);
+    Push(settlement.RealOpponentCount);
+    Push(settlement.BotOpponentCount);
+    Push(settlement.UniqueOpponentAccounts);
+    Push(settlement.SameAccountOpponent);
+    Push(settlement.SameIpOpponent);
+    Push(settlement.Inactive);
+    Push(settlement.Deserter);
+    Push(settlement.OpponentRosterKey);
+    Push(settlement.EventToken);
+    CallAllFunctions(PlayerEventBindings, key);
+}
+
