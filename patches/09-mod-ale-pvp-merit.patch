+void PvPMeritTracker::OnBattlegroundStart(Battleground* bg)
+{
+    if (!bg)
+        return;
+
+    BattlegroundState& state = _impl->Battlegrounds[bg->GetInstanceID()];
+    state = BattlegroundState{};
+    state.InstanceId = bg->GetInstanceID();
+    state.Started = true;
+    state.StartedAt = Clock::now();
+    state.StartedEpochMilliseconds = GetEpochMilliseconds();
+
+    for (auto const& playerPair : bg->GetPlayers())
+    {
+        Player* player = playerPair.second;
+        if (!player)
+            continue;
+
+        ParticipantState& participant = RegisterParticipant(state.Participants, player, player->GetBgTeamId());
+        OpenPresence(participant, 0);
