+void PvPMeritTracker::OnBattlegroundScoreUpdate(Battleground* bg, Player* player, uint32 type, uint32 value)
+{
+    if (!bg || !player || !value)
+        return;
+
+    auto stateItr = _impl->Battlegrounds.find(bg->GetInstanceID());
+    if (stateItr == _impl->Battlegrounds.end() || !stateItr->second.Started)
+        return;
+
+    ParticipantState& participant = RegisterParticipant(stateItr->second.Participants, player, player->GetBgTeamId());
+    uint32 const elapsed = GetElapsedSeconds(stateItr->second.StartedAt);
+    OpenPresence(participant, elapsed);
+
+    if (type == SCORE_KILLING_BLOWS || type == SCORE_HONORABLE_KILLS || type == SCORE_BONUS_HONOR || IsObjectiveScore(type))
+        MarkActive(participant, elapsed);
+
+    if (type == SCORE_KILLING_BLOWS || IsObjectiveScore(type))
+        participant.TacticalActions = SaturatingAdd(participant.TacticalActions, value);
+}
