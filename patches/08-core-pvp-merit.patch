+void OPvPCapturePoint::NotifyObjectiveCaptured()
+{
+    if (!_capturePoint || _team == TEAM_NEUTRAL)
+        return;
+
+    uint32 participantCount = 0;
+    for (ObjectGuid const& playerGuid : _activePlayers[_team])
+        if (ObjectAccessor::FindPlayer(playerGuid))
+            ++participantCount;
+
+    if (!participantCount)
+        return;
+
+    uint8 const objectiveTier = _pvp->GetTypeId() == OUTDOOR_PVP_NA ? 2 : 1;
+
+    for (ObjectGuid const& playerGuid : _activePlayers[_team])
+        if (Player* player = ObjectAccessor::FindPlayer(playerGuid))
+            _pvp->NotifyObjectiveCredit(player, m_capturePointSpawnId, _capturePoint->GetEntry(), objectiveTier,
+                participantCount);
+}
+
+void OutdoorPvP::NotifyObjectiveCredit(Player* player, uint32 objectiveId, uint32 objectiveEntry,
+    uint8 objectiveTier, uint32 participantCount)
+{
+    if (!player || player->GetTeamId() == TEAM_NEUTRAL || !participantCount)
+        return;
+
+    auto const epochMicros = std::chrono::duration_cast<std::chrono::microseconds>(
+        GameTime::GetSystemTime().time_since_epoch()).count();
+    std::string const eventToken = Acore::StringFormat("outdoor:{}:{}:{}:{}:{}", GetTypeId(), objectiveId,
+        uint8(player->GetTeamId()), epochMicros, player->GetGUID().GetRawValue());
+    sScriptMgr->OnPlayerOutdoorPvPObjective(player, GetTypeId(), objectiveId, objectiveEntry, objectiveTier,
+        player->GetTeamId(), participantCount, eventToken);
+}
