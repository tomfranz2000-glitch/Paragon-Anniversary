+// paragon reward track: players who know the marker spell keep two class auras
+// (SPELL_SPECIFIC_AURA — paladin auras) active at once instead of one
+static constexpr uint32 PARAGON_DUAL_AURA_MARKER = 1900008;
+
+// Pairwise contract of Aura::CanStackWith: returning false removes the existing aura.
+// Below the cap of two everything stacks; at the cap only the newest existing class
+// aura survives next to the incoming one, so casting a third swaps out the oldest.
+// The cap is counted on the caster and excludes the incoming aura by identity, which
+// also keeps area-aura re-applications on group members from tripping it.
+static bool ParagonAllowDualAura(Aura const* incoming, Aura const* existing)
+{
+    if (incoming->GetSpellInfo()->GetSpellSpecific() != SPELL_SPECIFIC_AURA
+            || existing->GetSpellInfo()->GetSpellSpecific() != SPELL_SPECIFIC_AURA)
+        return false;
+
+    Unit* caster = incoming->GetCaster();
+    if (!caster || !caster->IsPlayer() || !caster->ToPlayer()->HasSpell(PARAGON_DUAL_AURA_MARKER))
+        return false;
+
+    Aura const* newest = nullptr;
+    uint32 count = 0;
+    for (auto const& itr : caster->GetAppliedAuras())
+    {
+        Aura const* candidate = itr.second->GetBase();
+        if (candidate == incoming || candidate->GetCasterGUID() != incoming->GetCasterGUID())
+            continue;
+
+        if (candidate->GetSpellInfo()->GetSpellSpecific() != SPELL_SPECIFIC_AURA)
+            continue;
+
+        ++count;
+        if (!newest || candidate->GetApplyTime() > newest->GetApplyTime()
+                || (candidate->GetApplyTime() == newest->GetApplyTime() && candidate->GetId() > newest->GetId()))
+            newest = candidate;
+    }
+
+    return count < 2 || existing == newest;
+}
+
+// paragon reward track (see "Paragon Core Patches.md" §1h): players who know
+// the marker keep TWO of their blessings active per target instead of one.
+// Blessing cross-kind exclusivity is spell_group 1010 (the same-caster
+// umbrella of negative subgroup refs); same-kind pairs (Might vs Greater
+// Might) share a SUBGROUP, get the umbrella pruned in
+// CheckSpellGroupStackRules, and resolve through their own EXCLUSIVE /
+// EXCLUSIVE_HIGHEST branches above ours — so they stay exclusive with no
+// extra code. Membership is checked against group 1010 itself, so future
+// blessing-set changes stay data-driven.
+static constexpr uint32 PARAGON_DUAL_BLESSING_MARKER = 1900056;
+static constexpr uint32 PARAGON_BLESSING_SPELL_GROUP = 1010;
+
+static bool ParagonIsBlessingGroupMember(SpellInfo const* spellInfo)
+{
+    return sSpellMgr->IsSpellMemberOfSpellGroup(
+        spellInfo->GetFirstRankSpell()->Id, SpellGroup(PARAGON_BLESSING_SPELL_GROUP));
+}
+
+// Pairwise contract mirrors ParagonAllowDualAura: below the cap of two
+// everything stacks; at the cap only the newest existing blessing survives
+// next to the incoming one, so casting a third swaps out the oldest. The
+// count runs on the TARGET's aura map (blessings land on others, unlike the
+// self-anchored class auras) and only over this caster's blessings.
+static bool ParagonAllowDualBlessing(Aura const* incoming, Aura const* existing)
+{
+    if (!ParagonIsBlessingGroupMember(incoming->GetSpellInfo())
+            || !ParagonIsBlessingGroupMember(existing->GetSpellInfo()))
+        return false;
+
+    Unit* caster = incoming->GetCaster();
