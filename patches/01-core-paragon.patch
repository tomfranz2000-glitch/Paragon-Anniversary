+// Paragon reward-track patch (see "Paragon Core Patches.md" §1e): extra
+// permanent enchant slots. Marker spell (BASE + i), when known by the item
+// OWNER, unlocks the (i+1)-th extra permanent enchant on items matching that
+// marker's EquippedItemClass/subclass/inventory-type columns — spell_dbc
+// data, so raising the limit or extending to other item types is marker rows
+// + Lua only, no rebuild. On enchant, the previous permanent enchant shifts
+// into the first free extra slot (cascading and dropping the oldest when
+// full). Extra slots reuse enchantment slots that never carry a permanent
+// enchant natively: the prismatic slot and gem slots without a template
+// socket, skipping any slot holding a socket-granting enchant (belt buckle),
+// so gems and buckles are never displaced. All 12 slots are applied, procced
+// and persisted by slot-agnostic stock code.
+// Explicit id list, NOT a base+count range: 1900010-13 are the Divine
+// Strength rank 6-9 talent spells (EquippedItemClass -1, so they pass the
+// item-fit check) — a range starting at 1900009 counted a learned rank 6 as
+// a second enchant marker.
+// 1900009 = milestone 275 weapon marker; 1900033 = milestone 725's third
+// weapon slot; 1900057-66 = milestone 725's per-slot armor/ring/shield
+// ladder; 1900034-35 + 1900067-70 = reserved spares so future tiers stay
+// marker rows + Lua only (ids must stay clear of other custom spells —
+// check the docs §2a ledger before assigning).
+static constexpr std::array<uint32, 18> PARAGON_EXTRA_ENCHANT_MARKERS =
+    { 1900009, 1900033, 1900034, 1900035,
+      1900057, 1900058, 1900059, 1900060, 1900061, 1900062, 1900063,
+      1900064, 1900065, 1900066, 1900067, 1900068, 1900069, 1900070 };
+
+static bool ParagonSlotHoldsSocketEnchant(Item const* item, EnchantmentSlot slot)
+{
+    uint32 enchantId = item->GetEnchantmentId(slot);
+    if (!enchantId)
+        return false;
+    SpellItemEnchantmentEntry const* enchant = sSpellItemEnchantmentStore.LookupEntry(enchantId);
+    if (!enchant)
+        return false;
+    for (uint8 s = 0; s < MAX_SPELL_ITEM_ENCHANTMENT_EFFECTS; ++s)
+        if (enchant->type[s] == ITEM_ENCHANTMENT_TYPE_PRISMATIC_SOCKET)
+            return true;
+    return false;
+}
+
+static void ParagonShiftPermEnchant(Player* owner, Item* item, uint32 incomingEnchantId)
+{
+    uint32 capacity = 0;
+    for (uint32 markerId : PARAGON_EXTRA_ENCHANT_MARKERS)
+    {
+        if (!owner->HasSpell(markerId))
+            continue;
+        SpellInfo const* marker = sSpellMgr->GetSpellInfo(markerId);
+        if (marker && item->IsFitToSpellRequirements(marker))
+            ++capacity;
+    }
+    if (!capacity)
+        return;
+
+    uint32 previous = item->GetEnchantmentId(PERM_ENCHANTMENT_SLOT);
+    if (!previous || previous == incomingEnchantId)
+        return;
+
+    // usable extra slots, in shift order
+    EnchantmentSlot const candidates[] = { PRISMATIC_ENCHANTMENT_SLOT,
+        SOCK_ENCHANTMENT_SLOT_3, SOCK_ENCHANTMENT_SLOT_2, SOCK_ENCHANTMENT_SLOT };
+    EnchantmentSlot chain[4];
+    uint32 chainLength = 0;
+    for (EnchantmentSlot slot : candidates)
+    {
+        if (chainLength >= capacity)
+            break;
+        if (slot != PRISMATIC_ENCHANTMENT_SLOT
+            && item->GetTemplate()->Socket[slot - SOCK_ENCHANTMENT_SLOT].Color)
+            continue; // a real gem socket
+        if (ParagonSlotHoldsSocketEnchant(item, slot))
+            continue;
+        chain[chainLength++] = slot;
+    }
+    if (!chainLength)
+        return;
+
+    // the incoming enchant may already occupy an extra slot: clear that copy,
+    // it is about to become the primary again
+    for (uint32 i = 0; i < chainLength; ++i)
+    {
+        if (item->GetEnchantmentId(chain[i]) == incomingEnchantId)
+        {
+            owner->ApplyEnchantment(item, chain[i], false);
+            item->SetEnchantment(chain[i], 0, 0, 0);
+        }
+    }
+
+    // place the previous primary into the first free extra slot; when all are
+    // occupied, cascade down (the last chain slot's enchant is lost)
+    uint32 target = chainLength;
+    for (uint32 i = 0; i < chainLength; ++i)
+    {
+        if (!item->GetEnchantmentId(chain[i]))
+        {
+            target = i;
+            break;
+        }
+    }
+    if (target == chainLength)
+    {
+        target = 0;
+        for (uint32 i = chainLength - 1; i > 0; --i)
+        {
+            owner->ApplyEnchantment(item, chain[i], false);
+            item->SetEnchantment(chain[i], item->GetEnchantmentId(chain[i - 1]), 0, 0);
+            owner->ApplyEnchantment(item, chain[i], true);
+        }
+    }
+    owner->ApplyEnchantment(item, chain[target], false);
+    item->SetEnchantment(chain[target], previous, 0, 0);
+    owner->ApplyEnchantment(item, chain[target], true);
+}
+
+// paragon reward track §1e addendum (eager shift): after a permanent enchant
+// lands, immediately relocate it from the primary slot into a free extra
+// slot while capacity remains — the primary slot then stays EMPTY as the
+// landing pad for the next cast. The client fires its REPLACE_ENCHANT
+// confirmation whenever the primary slot is occupied, and that popup cannot
+// be accepted by addon code (ReplaceEnchant() is protected —
+// ADDON_ACTION_FORBIDDEN; the old addon-side auto-accept worked only by
+// taint-state accident and is deleted). With the pad kept empty the popup
+// appears exactly when accepting would truly overwrite: capacity full.
+static void ParagonEagerShiftNewEnchant(Player* owner, Item* item)
+{
+    uint32 enchantId = item->GetEnchantmentId(PERM_ENCHANTMENT_SLOT);
+    if (!enchantId)
+        return;
+
+    uint32 capacity = 0;
+    for (uint32 markerId : PARAGON_EXTRA_ENCHANT_MARKERS)
+    {
+        if (!owner->HasSpell(markerId))
+            continue;
+        SpellInfo const* marker = sSpellMgr->GetSpellInfo(markerId);
+        if (marker && item->IsFitToSpellRequirements(marker))
+            ++capacity;
+    }
+    if (!capacity)
+        return;
+
+    EnchantmentSlot const candidates[] = { PRISMATIC_ENCHANTMENT_SLOT,
+        SOCK_ENCHANTMENT_SLOT_3, SOCK_ENCHANTMENT_SLOT_2, SOCK_ENCHANTMENT_SLOT };
+    uint32 seen = 0;
+    EnchantmentSlot freeSlot = MAX_ENCHANTMENT_SLOT;
+    for (EnchantmentSlot slot : candidates)
+    {
+        if (seen >= capacity)
+            break;
+        if (slot != PRISMATIC_ENCHANTMENT_SLOT
+            && item->GetTemplate()->Socket[slot - SOCK_ENCHANTMENT_SLOT].Color)
+            continue; // a real gem socket
+        if (ParagonSlotHoldsSocketEnchant(item, slot))
+            continue;
+        ++seen;
+        // re-applying an enchant already parked in an extra slot: clear the
+        // old copy so the item never carries it twice
+        if (item->GetEnchantmentId(slot) == enchantId)
+        {
+            owner->ApplyEnchantment(item, slot, false);
+            item->SetEnchantment(slot, 0, 0, 0);
+        }
+        if (freeSlot == MAX_ENCHANTMENT_SLOT && !item->GetEnchantmentId(slot))
+            freeSlot = slot;
+    }
+    if (freeSlot == MAX_ENCHANTMENT_SLOT)
+        return; // capacity physically full: enchant stays primary, and the
+                // next cast's replace confirmation means a real overwrite
+
+    owner->ApplyEnchantment(item, PERM_ENCHANTMENT_SLOT, false);
+    item->SetEnchantment(PERM_ENCHANTMENT_SLOT, 0, 0, 0);
+    item->SetEnchantment(freeSlot, enchantId, 0, 0, owner->GetGUID());
+    owner->ApplyEnchantment(item, freeSlot, true);
+}
